# Copy to .env and fill in. Never commit .env -- it is gitignored.

# --- LLM: writes everything the hosts say ------------------------------------
# Get a key at https://openrouter.ai/keys  (free tier is enough for this)
OPENROUTER_API_KEY=
# Primary model. Must be a model you have access to.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Tried in order if the primary is rate limited or errors. Comma separated.
OPENROUTER_FALLBACKS=deepseek/deepseek-v4-flash,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free
# Sent to OpenRouter for attribution. Cosmetic.
OPENROUTER_REFERER=http://127.0.0.1:8080

# Reasoning models spend tokens thinking before answering. This is added to
# every request's max_tokens so the answer is not truncated. Harmless on
# non-reasoning models. Lower it if you switch to a non-reasoning model.
# Most models here can be told not to reason at all, which is faster and
# cheaper. Set to 0 if you ever want a model to think before writing.
OPENROUTER_DISABLE_REASONING=1
# Fallback for models that cannot switch reasoning off: added to every
# request's token budget so the answer is not eaten by the thinking.
OPENROUTER_REASONING_HEADROOM=1500

# --- Steam: patch notes + game ads -------------------------------------------
# Key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 64-bit SteamID. Find it at https://steamid.io if you only know your vanity URL.
STEAM_ID=
# Profile + game details must be public for the API to return your library.

# --- Server ------------------------------------------------------------------
PORT=8090
HOST=127.0.0.1
# Any long random string. Keeps your session across restarts.
FLASK_SECRET_KEY=

# --- Paths -------------------------------------------------------------------
# Obsidian vault the station writes its memory into. Relative to project root.
VAULT_DIR=vault
# Where downloaded audio is cached. Relative to project root.
CACHE_DIR=cache

# --- Spotify catalog search --------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Optional ----------------------------------------------------------------
# Set to 1 for verbose director/downloader logging.
RADIO_DEBUG=0
# Override the ffmpeg binary if it is not on PATH.
FFMPEG_BIN=ffmpeg

# Where pulled records are saved and imported from.
MUSIC_DIR=~/Music

# --- Remote listening (docs/REMOTE.md) -----------------------------------------
# Public names a Cloudflare Tunnel brings to this station. Comma separated.
# Leave empty to keep the station loopback-only.
REMOTE_HOSTS=
# Cloudflare Access in front of those names. Required whenever REMOTE_HOSTS is
# set: without both, every remote request is refused.
# Your team domain, e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# The Access application's Audience (AUD) tag, 64 hex characters.
CF_ACCESS_AUD=
# The named tunnel to run while the radio is on. Empty: no tunnel.
REMOTE_TUNNEL=
# Optional. Default: cloudflared on PATH, then Program Files (x86)\cloudflared.
CLOUDFLARED_BIN=
# Optional. Default: %USERPROFILE%\.cloudflared\<REMOTE_TUNNEL>.yml
CLOUDFLARED_CONFIG=
# The console's loopback stream server, and how it encodes.
BROADCAST_PORT=8091
# aac (ADTS) or mp3
BROADCAST_CODEC=aac
# kb/s
BROADCAST_BITRATE=160
